# ───────── Cloudflare credentials ─────────
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone -> DNS -> Edit   (+ Zone -> Zone -> Read if CF_ZONE_ID is left empty)
CF_API_TOKEN=your_cloudflare_api_token
# Optional: Zone ID (dashboard -> domain -> Overview, right column). Saves one API call.
CF_ZONE_ID=
# Comma separated FQDNs to keep in sync
CF_RECORDS=vps.example.com

# ───────── DDNS options ─────────
CF_ENABLE_IPV4=true
CF_ENABLE_IPV6=true
CF_CREATE_MISSING=true
# Only applied when a record is created
CF_PROXIED=false
CF_TTL=60
# Seconds between DDNS checks / forced re-verify with Cloudflare
DDNS_INTERVAL=300
DDNS_FORCE_SYNC=3600

# ───────── Network watchdog ─────────
CHECK_INTERVAL=30
CHECK_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
# auto | ping | tcp
CHECK_METHOD=auto
CHECK_TCP_PORT=443
# Consecutive failed checks before recovery starts
FAIL_THRESHOLD=3
# Leave empty to auto-detect from the default route
NET_IFACE=
RECOVERY_WAIT=20
RECOVERY_COOLDOWN=300
BOOT_GRACE=60
# Reboot the VPS if recovery keeps failing (off by default)
REBOOT_ON_FAILURE=false
REBOOT_AFTER_ROUNDS=3

LOG_LEVEL=INFO
